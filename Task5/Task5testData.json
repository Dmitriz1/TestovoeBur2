{
  "testGroups": [
    {
      "name": "Стандартный сценарий с валидными командами",
      "cases": [
        {
          "input": [
            "больше",
            "меньше",
            "равно"
          ],
          "expected": [
            "Загадайте число от 1 до 100. Я попробую угадать его!",
            "Ура! Я угадал число за 3 попыток: 26"
          ]
        },
        {
          "input": ["равно"],
          "expected": [
            "Загадайте число от 1 до 100. Я попробую угадать его!",
            "Ура! Я угадал число за 1 попытку: 50"
          ]
        }
      ]
    },
    {
      "name": "Невалидная команда",
      "cases": [
        {
          "input": [
            "некорректный",
            "равно"
          ],
          "expected": [
            "Загадайте число от 1 до 100. Я попробую угадать его!",
            "Пожалуйста, введите корректный ответ: 'больше', 'меньше' или 'равно'",
            "Ура! Я угадал число за 2 попыток: 50"
          ]
        }
      ]
    },

    {
    "name": "Слишком большое и маленькое значение",
    "cases": [
        {
          "input": ["больше", "больше", "больше", "больше", "больше", "больше", "больше", "больше"],
          "expected": [
            "Загадайте число от 1 до 100. Я попробую угадать его!",
            "Число вне диапазона 1-100. Попробуйте снова."
          ]
        },
        {
          "input": ["меньше", "меньше", "меньше", "меньше", "меньше", "меньше", "меньше", "меньше"],
          "expected": [
            "Загадайте число от 1 до 100. Я попробую угадать его!",
            "Число вне диапазона 1-100. Попробуйте снова."
          ]
        }
      ]
    }
  ]
}